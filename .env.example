# ========================================================
# SWEEPSTAKES HELPER (AUSTRIA) - CONFIGURATION
# ========================================================

# Execution settings
HEADLESS=true
INTERACTIVE_FALLBACK=true
PLAY_AUDIO_CHIME=true
MAX_ENTRIES_PER_RUN=25

# Browser timeouts & delays
BROWSER_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=7000
PAGE_LOAD_WAIT_MS=2500

# Rate limiting jitter (seconds)
MIN_REQUEST_DELAY=1.5
MAX_REQUEST_DELAY=4.5

# Notifications (Optional)
# Paste your Discord Webhook URL below to receive daily embeds
DISCORD_WEBHOOK_URL=

# Or Telegram Bot credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
